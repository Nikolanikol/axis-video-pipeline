# Порт веб-интерфейса: http://localhost:3210
PORT=3210
# Где хранятся лоты, фото и готовые ролики
DATA_DIR=data
# Рынок по умолчанию для новых лотов (файл config/markets/<id>.json)
DEFAULT_MARKET=mk
# Сколько кадров рендерить параллельно (пусто — Remotion решает сам).
# Замер на M1 (8 ядер, ролик 62 с): 4 → 293 с, 6 → 270 с, 8 → 256 с. Больше ядер помогает,
# потому что рендер ждёт браузер и чтение кадра из прокси, а не только считает.
RENDER_CONCURRENCY=
# Сколько роликов одной компании может ждать и идти разом (с базой SMMAKER).
# Очередь общая: без потолка один клиент занял бы машину на час
RENDER_MAX_PER_WORKSPACE=5
# Качество h264: меньше — лучше и тяжелее (18–23)
RENDER_CRF=20
# Свой Chrome/headless shell (пусто — Remotion скачает сам)
CHROME_PATH=
# Ключ ElevenLabs: распознавание речи и озвучка. Нужны доступы Speech to Text и Text to Speech.
# Без ключа кнопки распознавания и озвучки недоступны.
ELEVENLABS_API_KEY=
# Модель распознавания (по умолчанию scribe_v2)
ELEVENLABS_STT_MODEL=
# Голос для озвучки перевода (id из ElevenLabs). Без него кнопка «Озвучить перевод» не показывается.
ELEVENLABS_VOICE_ID=
# Модель синтеза. По умолчанию eleven_v3 — только она знает македонский.
ELEVENLABS_TTS_MODEL=

# Шлюз kmotors для каруселей: адрес приложения и секрет из его VEHICLE_API_SECRET
KMOTORS_API_URL=https://www.kmotors.shop
KMOTORS_API_SECRET=
# Вход по паролю (Basic Auth). Заданы оба — сервер требует вход (нужно при публичном домене).
# Пусто — без пароля (локально на Mac, где слушается только localhost).
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# База SMMAKER — Postgres в общем Supabase (там же kmotors и caranalizer). Подключаться
# напрямую к Postgres, не через пулер, и под своим пользователем smmaker_app
# (создаётся tools/db/setup.sql). Пусто — инструмент работает без базы, на файлах.
DATABASE_URL=
# Схема: пусто — smmaker на проде (NODE_ENV=production), smmaker_dev на Mac.
# Любое значение обязано начинаться с smmaker.
SMMAKER_DB_SCHEMA=
# Компания, от имени которой работает сервер (пока входа нет). Её файлы —
# data/workspaces/<id>/, настройки — строка в smmaker_workspaces.
SMMAKER_WORKSPACE=k-axis
# Тесты входа и кабинетов (tests/server/auth.test.mjs): свой Postgres с правом создавать
# схемы, не общий Supabase. Пусто — эти тесты пропускаются.
TEST_DATABASE_URL=
